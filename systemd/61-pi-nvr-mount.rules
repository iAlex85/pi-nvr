// Installed by Pi-NVR's install.sh.
//
// Grants the pi-nvr system user permission to start (and only start --
// not stop, restart, or manage any other unit) instances of the
// pi-nvr-mount@.service template, used exclusively by the Storage
// page's "detected drives" auto-setup feature. Mirrors
// 60-pi-nvr-format.rules exactly -- see that file's comment and
// SECURITY.md for the full rationale.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "__SERVICE_USER__") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if (unit && verb == "start" && unit.indexOf("pi-nvr-mount@") === 0) {
            return polkit.Result.YES;
        }
    }
});
